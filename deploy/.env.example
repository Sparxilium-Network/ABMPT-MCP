# ABMPT settings. setup.sh creates .env from this file and fills it in; it is safe to edit by
# hand afterwards (then run: sudo ./setup.sh upgrade).

# Format version of this file. setup.sh upgrades older files to the current version when a
# release adds or renames settings; do not change it by hand.
ABMPT_CONFIG_VERSION=1

# Host address the MCP port and game ports are published on. 0.0.0.0 = every interface.
# Published Docker ports bypass ufw / firewalld, so prefer the LAN IP of this host.
ABMPT_BIND_IP=0.0.0.0

# Every IP / hostname AI clients use to reach this service, comma separated. Written into the
# TLS server certificate. Keep localhost and 127.0.0.1 (setup.sh uses them for the health check).
ABMPT_TLS_SANS=localhost,127.0.0.1

# Set to true only by setup.sh, after the operator agreed to the Minecraft EULA
# (https://aka.ms/MinecraftEULA). Every instance created by this service then accepts it.
ABMPT_EULA_ACCEPTED=false
ABMPT_EULA_ACCEPTED_AT=

# Tuning (optional)
ABMPT_BOOT_TIMEOUT_SECS=600
ABMPT_STOP_TIMEOUT_SECS=90
ABMPT_AUTOSTART_DELAY_SECS=5
ABMPT_MAX_UPLOAD_MB=512
